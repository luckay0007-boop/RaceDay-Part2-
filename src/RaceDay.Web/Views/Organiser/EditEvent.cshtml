@model EventFormViewModel
@{
    ViewData["Title"] = "Edit Event";
    var provinces = new[]
    {
        "Eastern Cape", "Free State", "Gauteng", "KwaZulu-Natal",
        "Limpopo", "Mpumalanga", "Northern Cape", "North West", "Western Cape"
    };
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h1 class="h2 mb-1">Edit Event — @Model.Name</h1>
                <p class="text-muted small mb-0">Update event details, change publication status, or upload a new Azure Blob Storage banner</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId" class="btn btn-outline-dark btn-sm">
                    View Public Page
                </a>
                <a asp-action="Events" class="btn btn-outline-secondary btn-sm">&larr; Back to Events</a>
            </div>
        </div>

        <div class="rd-card p-4 p-md-5">
            @if (!string.IsNullOrWhiteSpace(Model.ExistingBannerUrl))
            {
                <div class="mb-4">
                    <div class="small fw-bold text-uppercase text-muted mb-2">Current Event Banner (Azure Blob Storage)</div>
                    <img src="@Model.ExistingBannerUrl" alt="@Model.Name banner" class="rd-detail-banner border" />
                </div>
            }

            <form asp-action="EditEvent" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="ExistingBannerUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="EventType" class="form-label fw-semibold"></label>
                        <select asp-for="EventType" class="form-select">
                            <option value="Running">Running</option>
                            <option value="Walking">Walking</option>
                            <option value="Cycling">Cycling</option>
                        </select>
                        <span asp-validation-for="EventType" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="EventDate" class="form-label fw-semibold"></label>
                        <input asp-for="EventDate" type="date" class="form-control" value="@Model.EventDate.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EventDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StartTime" class="form-label fw-semibold"></label>
                        <input asp-for="StartTime" type="time" class="form-control" value="@Model.StartTime.ToString("HH:mm")" />
                        <span asp-validation-for="StartTime" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Distance" class="form-label fw-semibold"></label>
                        <input asp-for="Distance" type="number" step="0.1" min="0.1" class="form-control" />
                        <span asp-validation-for="Distance" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-5">
                        <label asp-for="Location" class="form-label fw-semibold"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="City" class="form-label fw-semibold"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Province" class="form-label fw-semibold"></label>
                        <select asp-for="Province" class="form-select">
                            @foreach (var prov in provinces)
                            {
                                <option value="@prov">@prov</option>
                            }
                        </select>
                        <span asp-validation-for="Province" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Status" class="form-label fw-semibold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Draft">Draft</option>
                            <option value="Published">Published</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="BannerFile" class="form-label fw-semibold">Upload New Event Banner (Optional)</label>
                        <input asp-for="BannerFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
                        <div class="form-text">Leave blank to keep the existing banner image.</div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-rd-primary">
                        Save Event Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

