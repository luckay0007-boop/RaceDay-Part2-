@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-5 col-md-7">
        <div class="rd-card p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="rd-hero-kicker">Athlete &amp; Organiser Portal</span>
                <h1 class="h2 mb-1">Sign In to RaceDay</h1>
                <p class="text-muted small mb-0">Enter your credentials to access your role-specific dashboard</p>
            </div>

            <form asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email" class="form-control form-control-lg" placeholder="you@raceday.co.za" autocomplete="username" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-rd-primary btn-lg w-100 mb-3">
                    Sign In
                </button>

                <div class="text-center small text-muted">
                    New to RaceDay?
                    <a asp-action="Register" class="fw-bold text-decoration-none" style="color: var(--rd-primary);">
                        Create an Organiser or Participant account
                    </a>
                </div>
            </form>

            <hr class="my-4" />
            <div class="bg-light rounded-3 p-3 border small">
                <div class="fw-bold text-uppercase mb-2" style="letter-spacing: 0.05em; font-size: 0.75rem;">
                    Demo Accounts (Seeded on Startup)
                </div>
                <div class="d-flex justify-content-between mb-1">
                    <span><strong>Organiser:</strong> <code>organiser@raceday.co.za</code></span>
                    <span>Pass: <code>RaceDay@2026</code></span>
                </div>
                <div class="d-flex justify-content-between">
                    <span><strong>Participant:</strong> <code>runner@raceday.co.za</code></span>
                    <span>Pass: <code>RaceDay@2026</code></span>
                </div>
            </div>
        </div>
    </div>
</div>

