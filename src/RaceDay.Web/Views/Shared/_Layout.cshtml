@{
    var isAuthenticated = Context.Session.IsAuthenticated();
    var isOrganiser = Context.Session.IsOrganiser();
    var isParticipant = Context.Session.IsParticipant();
    var fullName = Context.Session.GetFullName();
    var email = Context.Session.GetEmail();
    var role = Context.Session.GetRole();
    var profilePic = Context.Session.GetProfilePictureUrl();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — RaceDay</title>
    <!-- Note: Pinned exact patch version 5.3.3 of Bootstrap with Subresource Integrity (SRI); update version and hash together when upgrading. -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand rd-brand" asp-controller="Events" asp-action="Index">
                    <span>RACE<span class="rd-brand-accent">DAY</span></span>
                </a>

                @if (isOrganiser)
                {
                    <span class="rd-role-pill rd-role-organiser ms-2 d-none d-sm-inline-block">Organiser Hub</span>
                }
                else if (isParticipant)
                {
                    <span class="rd-role-pill rd-role-participant ms-2 d-none d-sm-inline-block">Athlete Portal</span>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#rdNavbarContent"
                        aria-controls="rdNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="rdNavbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Events" ? "active" : "")"
                               asp-controller="Events" asp-action="Index">
                                Explore Events
                            </a>
                        </li>

                        @if (isOrganiser)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Organiser" && currentAction == "Dashboard" ? "active" : "")"
                                   asp-controller="Organiser" asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Organiser" && (currentAction == "Events" || currentAction == "CreateEvent" || currentAction == "EditEvent") ? "active" : "")"
                                   asp-controller="Organiser" asp-action="Events">
                                    Manage Events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Organiser" && currentAction == "Categories" ? "active" : "")"
                                   asp-controller="Organiser" asp-action="Categories">
                                    Categories
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Organiser" && currentAction == "Enrolments" ? "active" : "")"
                                   asp-controller="Organiser" asp-action="Enrolments">
                                    Enrolments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Organiser" && currentAction == "Results" ? "active" : "")"
                                   asp-controller="Organiser" asp-action="Results">
                                    Results Entry
                                </a>
                            </li>
                        }
                        else if (isParticipant)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Participant" && currentAction == "Enrolments" ? "active" : "")"
                                   asp-controller="Participant" asp-action="Enrolments">
                                    My Enrolments
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Participant" && currentAction == "Results" ? "active" : "")"
                                   asp-controller="Participant" asp-action="Results">
                                    My Results
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Profile" ? "active" : "")"
                                   asp-controller="Profile" asp-action="Index">
                                    My Profile
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (isAuthenticated)
                        {
                            <a class="nav-link d-flex align-items-center gap-2 text-white text-decoration-none me-2"
                               asp-controller="Profile" asp-action="Index" title="@PiiMasker.MaskEmail(email)">
                                @if (!string.IsNullOrWhiteSpace(profilePic))
                                {
                                    <img src="@profilePic" alt="@fullName" class="rd-avatar-sm" />
                                }
                                <div class="d-flex flex-column lh-sm">
                                    <span class="fw-semibold small text-white">@fullName</span>
                                    <span class="text-white-50" style="font-size: 0.72rem;">@role</span>
                                </div>
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-light fw-semibold">
                                    Sign Out
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light fw-semibold" asp-controller="Account" asp-action="Login">
                                Log In
                            </a>
                            <a class="btn btn-sm btn-rd-primary" asp-controller="Account" asp-action="Register">
                                Register Now
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    @if (isOrganiser && currentController == "Organiser")
    {
        <partial name="_OrganiserNav" />
    }

    <main role="main" class="container py-4 flex-grow-1">
        @if (TempData["SuccessMessage"] is string successMsg && !string.IsNullOrWhiteSpace(successMsg))
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                <strong>Success:</strong> @successMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMsg && !string.IsNullOrWhiteSpace(errorMsg))
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
                <strong>Notice:</strong> @errorMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
            <div>
                <span class="fw-bold text-white">RACE<span class="rd-brand-accent">DAY</span></span>
                <span class="ms-2">South Africa's Premier Athletic Event &amp; Timing Platform</span>
            </div>
            <div class="text-white-50 small">
                &copy; @DateTime.UtcNow.Year RaceDay Platform &bull; Powered by ASP.NET Core MVC &amp; Azure Blob Storage
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

